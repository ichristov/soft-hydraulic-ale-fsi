license: MIT
keywords:
  - fluid-structure interaction
  - soft hydraulics
  - arbitrary Lagrangian-Eulerian
  - finite element method
  - FEniCSx
  - DOLFINx
  - microfluidics
  - compliant microchannel
  - elastoinertial flow
version: "v0.2"
date-released: "2026-09-26"
